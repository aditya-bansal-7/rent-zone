# Server
PORT=5000
DEBUG=false

# Device: auto | cuda | cpu | mps
DEVICE=auto

# Paths
OUTPUT_DIR=outputs
HF_HOME=./hf_cache
CHECKPOINT_DIR=ckpt
UPLOAD_DIR=uploads

# Upload limits
MAX_UPLOAD_MB=20

# Inference defaults
NUM_INFERENCE_STEPS=30
GUIDANCE_SCALE=2.0
SEED=42

# Queue
MAX_QUEUE_SIZE=10

# Logging
LOG_LEVEL=INFO
LOG_FILE=server.log
